# CAD-Copilot AI server configuration. Copy to .env (gitignored) and fill in.
ENVIRONMENT=development

# --- Go live on Claude (the trial runs on ANTHROPIC ONLY, Sonnet 4.6) ---------------------
# Set BOTH of these to switch the pipeline from the offline mock to the real model:
ANTHROPIC_API_KEY=
# MODELS_CONFIG_PATH=configs/models.anthropic.json
#
# Leave them unset to stay on the offline mock gateway (no key needed) — the whole pipeline,
# eval harness, and tests still run. Fable 5 is NOT used (unavailable); Sonnet keeps cost low,
# with verifier-driven escalation to Opus 4.8 reserved for what Sonnet can't pass (ADR-002).

# Not used in the Anthropic-only trial:
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Limits
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_S=60
MAX_REQUEST_SIZE_MB=10
REQUEST_TIMEOUT_S=30

# PROD only — must be set explicitly when ENVIRONMENT=production
# CORS_ORIGINS_PROD=["https://your-domain"]
